# Copy to .env.local and fill in. Never commit real values.
# Every variable the app and scripts read is listed here. Platform-provided
# variables (NODE_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL) are set for
# you and are not listed as keys.
#
# Naming (TanStack Start / Vite): only VITE_-prefixed variables reach the
# browser; everything else is server-only. The Next.js-era names below are
# DEPRECATED but still read as fallbacks during the cutover window (production
# on Vercel may still set them). Rename them on the deployment, then delete:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY            -> VITE_CLERK_PUBLISHABLE_KEY (no fallback: set the new name)
#   NEXT_PUBLIC_VAPID_PUBLIC_KEY                 -> VITE_VAPID_PUBLIC_KEY (server fallback only)
#   NEXT_PUBLIC_SITE_URL                         -> SITE_URL (server-only)
#   NEXT_PUBLIC_APP_URL                          -> APP_URL (server-only)

# ── Database (PostgreSQL hosted on Supabase) ──────────────────────────────
# Runtime connection string used by Prisma (pg adapter). The pooled
# Supabase connection works here. Required: the app and `npm run build`
# fail at startup without it.
DATABASE_URL=
# Direct (non-pooled) connection for the Prisma CLI and the seed scripts.
# Optional: falls back to DATABASE_URL.
DIRECT_URL=

# ── Auth (Clerk) ──────────────────────────────────────────────────────────
# Read by @clerk/tanstack-react-start. Use pk_live/sk_live keys from a
# production instance for a public deployment and pk_test/sk_test keys from
# a development instance locally. Both are required: the TanStack SDK has no
# keyless mode. VITE_CLERK_PUBLISHABLE_KEY is public (shipped to the browser);
# CLERK_SECRET_KEY is server-only. The SDK does not read the old
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY name.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Site URLs ─────────────────────────────────────────────────────────────
# Canonical public URL (no trailing slash). Server-only. Used by robots.txt,
# sitemap.xml, canonical links and og:url/og:image. Falls back to the
# deprecated NEXT_PUBLIC_SITE_URL, then to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL. With none of them set, pages omit canonical
# links and robots.txt/sitemap.xml use http://localhost:3000 (a production
# server logs a warning once when that happens).
SITE_URL=
# Base URL for the Google Calendar OAuth redirect. Server-only, optional:
# falls back to the deprecated NEXT_PUBLIC_APP_URL, then the request origin.
APP_URL=

# ── Admin ─────────────────────────────────────────────────────────────────
# Comma-separated emails that can manage announcements at /admin.
ADMIN_EMAILS=

# ── Web push reminders ────────────────────────────────────────────────────
# VAPID key pair. Generate once with
#   npm run vapid:generate -- --subject=mailto:you@example.com
# Note: `npm run dev` runs the same script and replaces the keys in
# .env.local on every start, which breaks existing push subscriptions.
# VITE_VAPID_PUBLIC_KEY is public (the browser subscribes with it); the server
# also accepts the deprecated NEXT_PUBLIC_VAPID_PUBLIC_KEY name.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, as a mailto: or https: URL.
VAPID_SUBJECT=
# Long random string. GET /api/push/dispatch requires
# "Authorization: Bearer <CRON_SECRET>". Vercel Cron sends it automatically;
# .github/workflows/reminders-cron.yml sends the repository secret of the
# same name.
CRON_SECRET=
# Optional alternative secret for POST /api/push/dispatch (sent as the
# x-cron-secret header or a Bearer token). Falls back to CRON_SECRET.
PUSH_DISPATCH_SECRET=
# Optional. Set to 1 to log whether each VAPID setting is present
# (never the values).
PUSH_DISPATCH_DEBUG=

# ── Billing (Stripe) ──────────────────────────────────────────────────────
# Server-only. Use sk_test_ keys outside production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Read by the Stripe
# webhook route (billing Part C, after this migration); set it before then.
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) of the monthly and yearly plans. Checkout and the
# webhook accept only these two prices.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── Google Calendar sync ──────────────────────────────────────────────────
# OAuth client from Google Cloud Console. Redirect URI:
#   <app url>/api/calendar/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32-byte key, base64 or 64 hex characters. Encrypts stored Google tokens.
# Generate with: openssl rand -base64 32
CALENDAR_TOKENS_ENCRYPTION_KEY=

# ── Prayer times and Ramadan dates (optional) ─────────────────────────────
# IslamicAPI key. When set, prayer times try IslamicAPI first and fall back
# to AlAdhan, which needs no key.
ISLAMICAPI_KEY=
# Whole number from -2 to 2. Overrides the per-country Hijri date offset
# for every user.
HIJRI_OFFSET=
# Base URL of the Ramadan dates API. Defaults to https://ramadan.munafio.com
RAMADAN_OFFICIAL_API=

# ── Content seeding (scripts only, optional) ──────────────────────────────
# hadithapi.com key for scripts/seed-hadith.ts and scripts/test-hadith-api.ts.
# The scripts also accept the older misspelled name HADIHAD_API_KEY.
HADITHAPI_KEY=
