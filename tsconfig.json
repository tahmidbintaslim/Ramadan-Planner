{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vite/client", "node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": [
    "node_modules",
    ".output",
    ".vercel",
    ".nitro",
    ".tanstack",
    // TEMPORARY (TanStack migration Task 1): Next.js code not ported yet; Task 11 removes these.
    "src/app",
    "src/proxy.ts",
    // TEMPORARY: these import next/*, next-intl or @clerk/nextjs (directly or via another file here); ported in Tasks 2-8.
    "src/actions/admin-users.ts",
    "src/actions/announcements.ts",
    "src/actions/auth.ts",
    "src/actions/integrations.ts",
    "src/actions/planner.ts",
    "src/components/admin/announcements-admin-content.tsx",
    "src/components/auth/forgot-password-form.tsx",
    "src/components/auth/login-form.tsx",
    "src/components/auth/sign-in-or-up-form.tsx",
    "src/components/auth/signup-form.tsx",
    "src/components/dashboard/dashboard-content.tsx",
    "src/components/hadith/hadith-audio-controls.tsx",
    "src/components/landing/prayer-times-widget.tsx",
    "src/components/landing/quran-preview.tsx",
    "src/components/landing/ramadan-status-banner.tsx",
    "src/components/landing/ramadan-timetable.tsx",
    "src/components/layout/app-header.tsx",
    "src/components/layout/app-shell.tsx",
    "src/components/layout/desktop-sidebar.tsx",
    "src/components/layout/mobile-nav.tsx",
    "src/components/plan/plan-content.tsx",
    "src/components/providers/auth-provider.tsx",
    "src/components/quran/quran-reader.tsx",
    "src/components/quran/quran-surah-list.tsx",
    "src/components/reminders/reminders-content.tsx",
    "src/components/settings/settings-content.tsx",
    "src/components/shared/accessibility-sidebar.tsx",
    "src/components/shared/announcements-strip.tsx",
    "src/components/shared/daily-ibadah-tracker.tsx",
    "src/components/shared/floating-quick-nav.tsx",
    "src/components/shared/signup-prompt.tsx",
    "src/components/today/daily-checklist.tsx",
    "src/components/today/journal-section.tsx",
    "src/components/today/quran-tracker.tsx",
    "src/components/today/salah-tracker.tsx",
    "src/components/today/today-content.tsx",
    "src/components/ui/dialog.tsx",
    "src/components/ui/sheet.tsx",
    "src/hooks/use-guest-data.ts",
    "src/lib/auth/server.ts",
    "src/lib/supabase/middleware.ts",
    "src/lib/supabase/server.ts"
  ]
}
