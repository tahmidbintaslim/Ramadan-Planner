{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ramadan Planner",
  "version": "0.1.0",
  "identifier": "space.tahmid.ramadanplanner",
  "build": {
    "frontendDist": "../native/www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ramadan Planner",
        "url": "https://ramadanplanner.tahmid.space",
        "width": 1280,
        "height": 800,
        "minWidth": 834,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
